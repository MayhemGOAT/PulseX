# xAI Grok API key (https://console.x.ai) — primary AI for tweet scoring + council
XAI_API_KEY=xai-your_key_here
PULSEX_GROK_MODEL=grok-3-mini
PULSEX_GROK=auto

# X API v2 bearer token (https://developer.x.com) — live tweet fetching
X_BEARER_TOKEN=your_bearer_token_here

# Target asset
PULSEX_TICKER=SPY
PULSEX_START=2018-01-01

# Fast mode: skip FinBERT download, use keyword scoring (set 1 for local dev)
PULSEX_FAST=1
